@@ -1120,6 +1120,24 @@ public:
     bool Create(ObjectGuid::LowType guidlow, CharacterCreateInfo* createInfo);
 
     void Update(uint32 time) override;
+    // GuildAdventure: CP-11 - a character without a client (a bot) is updated once every interval ms (Bots.UpdateInterval),
+    // at a phase of its own, so the bots of a map are spread over the world ticks. True when it is due: diff is then the
+    // time since its last update. The diffs of the ticks it skips are collected.
+    bool TakeBotUpdate(uint32 tickDiff, uint32 interval, uint32& diff)
+    {
+        if (m_botUpdatePhase >= interval + interval) // not phased yet (or the interval shrank): a phase from its guid
+            m_botUpdatePhase = uint32((uint64(GetGUID().GetCounter()) * 2654435761ull) % interval);
+        m_botUpdatePhase += tickDiff;
+        m_deferredUpdateDiff += tickDiff;
+        if (m_botUpdatePhase < interval)
+            return false;
+        m_botUpdatePhase %= interval;
+        diff = m_deferredUpdateDiff;
+        m_deferredUpdateDiff = 0;
+        return true;
+    }
+    // A character a client plays is updated every tick: what it collected as a bot comes with its next update.
+    uint32 TakeDeferredUpdateDiff() { uint32 const diff = m_deferredUpdateDiff; m_deferredUpdateDiff = 0; return diff; }
 
